        print(f" 📍 สถานที่เกิด: {location.title()}")
        print(f" ⏰ เวลาสุริยคติปรับแล้ว (True Solar Time): {adjusted_dt.strftime('%H:%M น.')}")
        print("-" * 60)
        print(" 🏛️ [ ผัง 4 เสาหลัก 8 อักษร / Four Pillars Chart ]\n")
        
        for key, item in pillars.items():
            s = item["stem"]
            b = item["branch"]
            print(f" • {item['name_kr']:<28} : {s['hanja']} {b['hanja']}  |  {s['kr']} x {b['kr']} ({b['animal']})")

