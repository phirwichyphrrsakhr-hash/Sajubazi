            {"hanja": "己", "kr": "기 (Gi)", "element": "ดิน (Earth)", "yin_yang": "Yin (-)"},
            {"hanja": "庚", "kr": "경 (Gyeong)", "element": "ทอง (Metal)", "yin_yang": "Yang (+)"},
