        print(f" • คู่พลังงานฐาน    : {day_branch['kr']} ({day_branch['element']})")
        print("\n 💡 คำวิเคราะห์สไตล์ Gen Z:")
        
        # บทวิเคราะห์จำแนกตามธาตุตัวตนหลัก (Day Master Element)
        element_vibes = {
            "ไม้ (Wood)": "คุณมี Main Character Energy สายเติบโต! หัวไว เรียนรู้เร็ว ไอเดียพุ่งกระฉูดตลอดเวลา ยืดหยุ่นเก่งและจริงใจกับความรู้สึกตัวเองสุดๆ",
