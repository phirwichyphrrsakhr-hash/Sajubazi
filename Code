        # พิกัดลองจิจูดของสถานที่ยอดฮิต เพื่อปรับเวลาสุริยคติแท้จริง (True Solar Time Adjustment)
        self.LONGITUDE_MAP = {
            "seoul": 126.9780,
            "bangkok": 100.5018,
            "tokyo": 139.6917,
            "beijing": 116.4074,
            "london": -0.1278,
            "new york": -74.0060
        }

    def _adjust_solar_time(self, dt, city_name):
        """คำนวณปรับเวลาตามพิกัดสถานที่เกิด (Longitude Offset) เพื่อความแม่นยำ 100%"""
        city_lower = city_name.lower().strip()
        if city_lower in self.LONGITUDE_MAP:
            lon = self.LONGITUDE_MAP[city_lower]
            # มาตรฐานเวลาฐาน (Standard Meridian offset)
            std_meridian = round(lon / 15.0) * 15
            time_diff_minutes = (lon - std_meridian) * 4
            return dt + datetime.timedelta(minutes=time_diff_minutes)
        return dt

    def analyze(self, year, month, day, hour, minute, location="Seoul"):
        raw_dt = datetime.datetime(year, month, day, hour, minute)
        adjusted_dt = self._adjust_solar_time(raw_dt, location)

        # 1. Year Pillar (연주)
        y_stem_idx = (adjusted_dt.year - 4) % 10
        y_branch_idx = (adjusted_dt.year - 4) % 12

        # 2. Month Pillar (월주)
        m_branch_idx = (adjusted_dt.month + 1) % 12
        m_stem_idx = (y_stem_idx * 2 + adjusted_dt.month) % 10

        # 3. Day Pillar (일주) - Julian Day Number Algorithm
        a = (14 - adjusted_dt.month) // 12
        y = adjusted_dt.year + 4800 - a
        m = adjusted_dt.month + 12 * a - 3
        jdn = adjusted_dt.day + (153 * m + 2) // 5 + 365 * y + y // 4 - y // 100 + y // 400 - 32045
        
        d_stem_idx = (jdn - 1) % 10
        d_branch_idx = (jdn + 1) % 12

        # 4. Hour Pillar (시주)
        h_branch_idx = ((adjusted_dt.hour + 1) % 24) // 2
        h_stem_idx = (d_stem_idx * 2 + h_branch_idx) % 10

        # สร้างข้อมูลโครงสร้าง 4 เสา
        pillars = {
            "Year": {"stem": self.STEMS[y_stem_idx], "branch": self.BRANCHES[y_branch_idx], "name_kr": "연주 (เสาปีเกิด)"},
            "Month": {"stem": self.STEMS[m_stem_idx], "branch": self.BRANCHES[m_branch_idx], "name_kr": "월주 (เสาเดือนเกิด)"},
            "Day": {"stem": self.STEMS[d_stem_idx], "branch": self.BRANCHES[d_branch_idx], "name_kr": "일주 (เสาวันเกิด - ตัวตนหลัก)"},
            "Hour": {"stem": self.STEMS[h_stem_idx], "branch": self.BRANCHES[h_branch_idx], "name_kr": "시주 (เสายามเกิด)"}
        }

        self._print_result(raw_dt, adjusted_dt, location, pillars)

    def _print_result(self, raw_dt, adjusted_dt, location, pillars):
